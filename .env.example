# ==========================================
# Application Global Environment Variables
# ==========================================

# Environment Mode: development | production | test
NODE_ENV=development

# ------------------------------------------
# Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=productivity_assistant_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productivity_assistant_db?schema=public"

# ------------------------------------------
# Backend API (Node.js + Express)
# ------------------------------------------
PORT=5000
JWT_SECRET=super_secret_jwt_access_key_change_in_production_32chars!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_32chars!
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# AI Microservice (Python + FastAPI)
# ------------------------------------------
AI_PORT=8000
LLM_PROVIDER=gemini # options: gemini, openai, mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=text-embedding-004

# ------------------------------------------
# Frontend Client (React + Vite)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
