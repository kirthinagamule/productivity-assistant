// Complete PostgreSQL + Prisma Schema for AI-Powered Personal Productivity Assistant

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ==========================================
// Enums
// ==========================================

enum Role {
  USER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  DISMISSED
  SNOOZED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EntityType {
  TASK
  NOTE
  CALENDAR_EVENT
  CHAT_MESSAGE
  DAILY_PLAN
}

enum BurnoutRisk {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// ==========================================
// User Entity
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role     @default(USER)
  timezone     String   @default("UTC")
  preferences  Json?    @default("{\"theme\": \"system\", \"dailyReminderTime\": \"08:00\", \"workHourStart\": 9, \"workHourEnd\": 17}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks               Task[]
  notes               Note[]
  reminders           Reminder[]
  calendarEvents      CalendarEvent[]
  chatConversations   ChatConversation[]
  productivityMetrics ProductivityMetric[]
  tags                Tag[]
  embeddings          Embedding[]

  @@map("users")
}

// ==========================================
// Task Entity
// ==========================================

model Task {
  id               String     @id @default(uuid())
  userId           String
  title            String
  description      String?    @db.Text
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  dueDate          DateTime?
  estimatedMinutes Int?       @default(30)
  actualMinutes    Int?       @default(0)
  aiPriorityScore  Float?     @default(0.0) // 0.0 to 10.0
  aiSuggestedSlot  DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]
  reminders      Reminder[]
  calendarEvents CalendarEvent[]
  embeddings     Embedding[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, createdAt])
  @@map("tasks")
}

// ==========================================
// Note Entity
// ==========================================

model Note {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String   @db.Text
  summary    String?  @db.Text
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags   NoteTag[]
  embeddings Embedding[]

  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@index([userId, createdAt])
  @@map("notes")
}

// ==========================================
// Reminder Entity
// ==========================================

model Reminder {
  id            String         @id @default(uuid())
  userId        String
  taskId        String?
  title         String
  remindAt      DateTime
  isSent        Boolean        @default(false)
  status        ReminderStatus @default(PENDING)
  repeatPattern String? // "DAILY", "WEEKLY", "MONTHLY", null
  snoozeUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, remindAt, isSent])
  @@index([userId, status])
  @@map("reminders")
}

// ==========================================
// CalendarEvent Entity
// ==========================================

model CalendarEvent {
  id             String   @id @default(uuid())
  userId         String
  taskId         String?
  title          String
  description    String?  @db.Text
  startTime      DateTime
  endTime        DateTime
  isAllDay       Boolean  @default(false)
  location       String?
  eventColor     String   @default("#6366F1")
  isAiGenerated  Boolean  @default(false)
  recurrenceRule String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startTime, endTime])
  @@index([userId, isAiGenerated])
  @@map("calendar_events")
}

// ==========================================
// ChatConversation & ChatMessage Entities
// ==========================================

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id                String      @id @default(uuid())
  conversationId    String
  role              MessageRole @default(USER)
  content           String      @db.Text
  contextReferences Json? // Array of referenced entity metadata: [{ type: "task", id: "..." }]
  tokensUsed        Int?        @default(0)
  createdAt         DateTime    @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ==========================================
// ProductivityMetric Entity
// ==========================================

model ProductivityMetric {
  id               String      @id @default(uuid())
  userId           String
  date             DateTime    @db.Date
  tasksCompleted   Int         @default(0)
  focusMinutes     Int         @default(0)
  efficiencyScore  Float       @default(0.0) // 0 to 100
  burnoutRiskLevel BurnoutRisk @default(LOW)
  metadata         Json? // Detailed daily breakdown: { deepWorkSessions: 3, completionsByPriority: {} }
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("productivity_metrics")
}

// ==========================================
// Tag & Many-to-Many Join Entities
// ==========================================

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]
  noteTags NoteTag[]

  @@unique([userId, name])
  @@index([userId, name])
  @@map("tags")
}

model TaskTag {
  id        String   @id @default(uuid())
  taskId    String
  tagId     String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
  @@map("task_tags")
}

model NoteTag {
  id        String   @id @default(uuid())
  noteId    String
  tagId     String
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
  @@map("note_tags")
}

// ==========================================
// Embedding Entity (Vector Similarity Search)
// ==========================================

model Embedding {
  id         String                      @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  taskId     String?
  noteId     String?
  content    String                      @db.Text
  embedding  Unsupported("vector(768)")?
  metadata   Json?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@index([entityId])
  @@map("embeddings")
}
